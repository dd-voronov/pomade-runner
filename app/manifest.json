{
  "id": "pomade-runner",
  "name": "Runner",
  "version": "0.1.0",
  "hostApi": 0,
  "icon": "icon.svg",
  "capabilities": [
    "project.read",
    "files.read",
    "files.write",
    "tabs.open"
  ],
  "strip": [
    {
      "id": "runner",
      "title": "Runner",
      "action": "panel"
    }
  ],
  "skills": [
    "skills/pomade-runner-jobs"
  ],
  "events": {
    "publish": [
      "jobs.changed",
      "services.changed",
      "runs.changed",
      "run.started",
      "run.finished"
    ],
    "subscribe": [
      "pomade-runner:jobs.changed",
      "pomade-runner:services.changed",
      "pomade-runner:runs.changed",
      "pomade.ready",
      "project.created",
      "project.renamed",
      "attachedTab.action"
    ]
  },
  "backend": {
    "entry": "backend/scheduler.mjs",
    "mode": "always-on",
    "restartOnUpdate": true
  },
  "api": [
    "jobs.list",
    "services.list",
    "services.start",
    "services.stop",
    "services.restart",
    "runs.list",
    "runs.get",
    "runs.output",
    "history.list",
    "jobs.run",
    "jobs.setEnabled",
    "needsYou.dismiss"
  ],
  "commands": [
    {
      "name": "pomade-runner",
      "entry": "cli/pomade-runner.mjs",
      "title": "Runner from the command line"
    }
  ]
}
