{
  "id": "pomade-runner",
  "name": "Runner",
  "version": "0.1.0-rc.5",
  "hostApi": 0,
  "icon": "icon.svg",
  "capabilities": [
    "project.read",
    "files.read",
    "files.write",
    "tabs.open",
    "git.read"
  ],
  "strip": [
    {
      "id": "runner",
      "title": "Runner",
      "action": "panel"
    }
  ],
  "tabKinds": {
    "output": {
      "title": "Output",
      "icon": "output.svg"
    }
  },
  "skills": [
    "skills/pomade-runner-jobs"
  ],
  "events": {
    "publish": [
      "jobs.changed",
      "services.changed",
      "runs.changed",
      "settings.changed",
      "run.started",
      "run.finished"
    ],
    "subscribe": [
      "pomade-runner:jobs.changed",
      "pomade-runner:services.changed",
      "pomade-runner:runs.changed",
      "pomade-runner:settings.changed",
      "pomade.ready",
      "project.created",
      "project.renamed",
      "project.opened",
      "project.changed",
      "attachedTab.action",
      "pomade-agents:session.closed",
      "pomade-agents:session.statusChanged"
    ]
  },
  "backend": {
    "entry": "backend/scheduler.mjs",
    "mode": "always-on",
    "restartOnUpdate": true
  },
  "api": [
    "jobs.list",
    "services.list",
    "services.start",
    "services.stop",
    "services.restart",
    "runs.list",
    "runs.get",
    "runs.output",
    "history.list",
    "jobs.run",
    "jobs.setEnabled",
    "needsYou.dismiss",
    "runs.missed",
    "runs.stop",
    "switch.set",
    "jobs.resume",
    "settings.get",
    "settings.set",
    "environment.get",
    "jobs.forRepo",
    "jobs.delete"
  ],
  "calls": [
    "pomade-agents"
  ],
  "commands": [
    {
      "name": "pomade-runner",
      "entry": "cli/pomade-runner.mjs",
      "title": "Runner from the command line"
    }
  ]
}
