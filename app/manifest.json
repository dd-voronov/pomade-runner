{
  "id": "pomade-runner",
  "name": "Runner",
  "version": "0.1.0",
  "hostApi": 0,
  "icon": "icon.svg",
  "capabilities": [
    "project.read",
    "files.read",
    "files.write",
    "tabs.open"
  ],
  "strip": [
    {
      "id": "runner",
      "title": "Runner",
      "action": "panel"
    }
  ],
  "skills": [
    "skills/pomade-runner-jobs"
  ],
  "events": {
    "publish": [
      "jobs.changed"
    ],
    "subscribe": [
      "pomade-runner:jobs.changed",
      "project.created",
      "project.renamed",
      "attachedTab.action"
    ]
  },
  "backend": {
    "entry": "backend/scheduler.mjs",
    "mode": "always-on",
    "restartOnUpdate": true
  },
  "api": [
    "jobs.list"
  ],
  "commands": [
    {
      "name": "pomade-runner",
      "entry": "cli/pomade-runner.mjs",
      "title": "Runner from the command line"
    }
  ]
}
