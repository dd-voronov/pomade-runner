{
  "name": "pomade-runner",
  "version": "0.1.0",
  "description": "Runner — the Pomade app that runs services, scripts, git operations and agents on schedules and hooks",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "repository": "github:dd-voronov/pomade-runner",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.ui.json && tsc -p tsconfig.e2e.json",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "gate": "npm run lint && npm run typecheck && npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "node-pty": "1.1.0",
    "pomade-kit": "github:dd-voronov/pomade-kit#v0.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-playwright": "^2.12.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
